{
  "name": "solace-hub",
  "version": "1.0.0",
  "private": true,
  "description": "SOLACE — hub de telemetría y control (ESP32 → Mac → Broker MQTT → n suscriptores)",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts --dev",
    "build": "vite build",
    "start": "vite build && NODE_ENV=production tsx server/index.ts",
    "simulate": "tsx scripts/simulate-esp32.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:firmware": "make -C firmware/test",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run test:firmware && npm test && npm run test:e2e",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "aedes": "^1.2.0",
    "bonjour-service": "^1.4.4",
    "express": "^5.3.0",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "mqtt": "^5.16.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.1",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
